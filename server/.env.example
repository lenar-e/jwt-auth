# ─────────────────────────────────────────────────────────────
# Server configuration — copy this file to `.env` and fill it in.
# NEVER commit the real `.env` file.
# ─────────────────────────────────────────────────────────────

# HTTP port the Nest server listens on
PORT=5000

# MongoDB connection string (e.g. a MongoDB Atlas cluster)
DB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# JWT signing secrets — use long, random strings (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret

# SMTP credentials used by nodemailer (Gmail App Password recommended)
MAIL_USER=your.email@gmail.com
MAIL_PASS=your-app-password

# Base URL of the client app, used to build activation / reset links
CLIENT_URL=http://127.0.0.1:5173
